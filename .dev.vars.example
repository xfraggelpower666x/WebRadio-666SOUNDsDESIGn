# Local-only example for Wrangler development.
# Copy to .dev.vars locally. Never commit real values.

# Canonical admin authentication broker
ADMIN_AUTH_LOGIN_URL=https://666-system-pw.666soundsdesign-broadcaster.com/login
ADMIN_AUTH_VERIFY_URL=https://666-system-auth.666soundsdesign-broadcaster.com/verify
ADMIN_SERVICE_ORIGIN=https://webradio.666soundsdesign-broadcaster.com
AUTH_AUDIENCE=666SOUNDsDESIGn-WebRadio-Admin
AUTH_MODE=external_auth_worker
ADMIN_SERVICE_TOKEN=

# GitHub-backed runtime configuration
GITHUB_TOKEN=
GITHUB_OWNER=xfraggelpower666x
GITHUB_REPO=WebRadio-666SOUNDsDESIGn
GITHUB_BRANCH=WebRadio-666SOUNDsDESIGn
GITHUB_CONFIG_PATH=config/radio-runtime.json
GITHUB_BACKUP_DIR=config/backups

# Player Alert Worker -> Render service authentication
PLAYER_ALERT_BACKEND_URL=https://auto-setup-render-for-backend-mp3-ess8.onrender.com
PLAYER_ALERT_SERVICE_TOKEN=
PLAYER_ALERT_WRITE_TOKEN=

# Debug endpoints remain hidden unless a token is configured.
DEBUG_TOKEN=
ENABLE_PUBLIC_DEBUG=false

# Skip / Next Track bridge. Use headers by default.
SHOUTCAST_ADMIN_URL=https://my.idjstream.com:8686/admin.cgi
SHOUTCAST_ADMIN_USER=admin
SHOUTCAST_ADMIN_PASSWORD=
SHOUTCAST_SID=1
SHOUTCAST_SKIP_MODE=nextsong
SKIP_ALLOW_QUERY_SECRET=false
ADMIN_SKIP_COOLDOWN_MS=12000

# Alternative provider bridge
SONICPANEL_SKIP_URL=
SONICPANEL_SKIP_TOKEN=
