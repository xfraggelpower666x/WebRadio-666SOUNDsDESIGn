{
  "version": "2026-05-24",
  "purpose": "Renderer deploy-awareness for WebRadio fullversion with Chaos Engine.",
  "player_paths_to_preserve": [
    "worker.js",
    "index.html",
    "wrangler.jsonc",
    "assets/",
    "css/",
    "js/",
    "config/",
    "worker-addons/",
    "CHAOS_ENGINE/"
  ],
  "new_important_paths": {
    "chaos_engine": [
      "CHAOS_ENGINE/index.html",
      "CHAOS_ENGINE/track-factory.html",
      "CHAOS_ENGINE/fraggle-detlef-system.html",
      "CHAOS_ENGINE/assets/css/",
      "CHAOS_ENGINE/assets/js/",
      "CHAOS_ENGINE/assets/data/"
    ],
    "admin_runtime": [
      "config/radio-runtime.json",
      "config/admin-runtime.env.example",
      "config/backups/"
    ],
    "worker_addons": [
      "worker-addons/radio-admin-config-addon.js",
      "worker-addons/chaos-engine-api-addon.js"
    ]
  },
  "rules": [
    "Do not flatten nested directories.",
    "Do not delete worker.js, index.html, config, worker-addons or CHAOS_ENGINE.",
    "Do not write secrets into repo files.",
    "Preserve file names and casing exactly."
