# Canonical WebRadio admin auth integration. Real secret values stay in Cloudflare Secrets.

ADMIN_AUTH_LOGIN_URL=https://666-system-pw.666soundsdesign-broadcaster.com/login
ADMIN_AUTH_VERIFY_URL=https://666-system-auth.666soundsdesign-broadcaster.com/verify
ADMIN_SERVICE_ORIGIN=https://webradio.666soundsdesign-broadcaster.com
AUTH_AUDIENCE=666SOUNDsDESIGn-WebRadio-Admin
AUTH_MODE=external_auth_worker
ADMIN_SERVICE_TOKEN=put_real_service_token_in_worker_secret_only

GITHUB_TOKEN=put_real_token_in_worker_secret_only
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-player-repo
GITHUB_BRANCH=main
GITHUB_CONFIG_PATH=config/radio-runtime.json
GITHUB_BACKUP_DIR=config/backups

PLAYER_ALERT_BACKEND_URL=
PLAYER_ALERT_SERVICE_TOKEN=put_real_service_token_in_worker_secret_only

# Skip / Next Track bridge. Real values must be Worker secrets, never frontend values.
SHOUTCAST_ADMIN_URL=https://my.idjstream.com:8686/admin.cgi
SHOUTCAST_ADMIN_USER=admin
SHOUTCAST_ADMIN_PASSWORD=put_real_shoutcast_admin_password_in_worker_secret_only
SHOUTCAST_SID=1
SHOUTCAST_SKIP_MODE=nextsong
SONICPANEL_SKIP_URL=
SONICPANEL_SKIP_TOKEN=
