# Admin/Auth/GitHub required ENV names. Real values must stay secret.

ADMIN_AUTH_VERIFY_URL=https://666-system-auth.666soundsdesign-broadcaster.com/verify
PW_LOGIN_URL=https://666-system-pw.666soundsdesign-broadcaster.com/login
PW_HEALTH_URL=https://666-system-pw.666soundsdesign-broadcaster.com/health

GITHUB_TOKEN=put_real_token_in_worker_secret_only
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-player-repo
GITHUB_BRANCH=main
GITHUB_CONFIG_PATH=config/radio-runtime.json
GITHUB_BACKUP_DIR=config/backups

OPENAI_API_KEY=put_real_key_in_worker_secret_only
OPENAI_MODEL=gpt-4.1-mini

PLAYER_ALERT_BACKEND_URL=

# Skip / Next Track bridge. Real values must be Worker secrets, never frontend values.
# Canonical route: Main Worker -> 666myidjstreamadmin -> Shoutcast admin.cgi.
MYIDJ_WORKER_SKIP_URL=https://666myidjstreamadmin.666soundsdesign-broadcaster.com/api/radio/skip
MYIDJ_WORKER_ADMIN_TOKEN=put_matching_myidj_worker_admin_token_in_worker_secret_only
SHOUTCAST_ADMIN_URL=https://my.idjstream.com:8686/admin.cgi
SHOUTCAST_ADMIN_USER=admin
SHOUTCAST_ADMIN_PASSWORD=put_real_shoutcast_admin_password_in_worker_secret_only
SHOUTCAST_SID=1
SHOUTCAST_SKIP_MODE=nextsong
MYIDJ_ADMIN_USER=admin
MYIDJ_ADMIN_PASSWORD=put_real_myidj_admin_password_in_worker_secret_only
SKIP_ADMIN_TOKEN=put_worker_skip_admin_token_in_worker_secret_only
SKIP_VOTE_THRESHOLD=3

# ADMIN CONFIG SYSTEM V1
# These must be Worker ENV/secrets, never frontend values.
GITHUB_CONFIG_PATH=config/radio-runtime.json
GITHUB_BACKUP_DIR=config/backups
ADMIN_CONFIG_ALLOWED_PATHS=config/radio-runtime.json

# Optional status endpoints

# HARDLOCK service-to-service authentication
ADMIN_SERVICE_ORIGIN=https://webradio.666soundsdesign-broadcaster.com
AUTH_AUDIENCE=666SOUNDsDESIGn-WebRadio-Admin
ADMIN_SERVICE_TOKEN=put_shared_service_token_in_worker_secret_only
