{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "666-chaos-ai-track-system",
  "main": "worker.js",
  "compatibility_date": "2025-05-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "666-chaos-ai-track-system.666soundsdesign-broadcaster.com/*",
      "custom_domain": true
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "SUNO_WORKER_BASE_URL": "https://666-suno-system.666soundsdesign-broadcaster.com",
    "ADMIN_AUTH_VERIFY_URL": "https://666-system-auth.666soundsdesign-broadcaster.com/verify",
    "ALLOWED_ORIGINS": "https://666soundsdesign-broadcaster.com,https://www.666soundsdesign-broadcaster.com"
  }
}
