{
  "name": "666-suno-system",
  "type": "cloudflare-worker",
  "version": "1.0.1",
  "updated": "2026-06-25",
  "adapter": "configurable-generic-rest-provider",
  "secrets": [
    "ADMIN_AUTH_URL",
    "SUNO_API_KEY"
  ],
  "optionalBindings": [
    "SUNO_JOBS_KV"
  ],
  "variables": [
    "SUNO_API_BASE_URL",
    "SUNO_CREATE_PATH",
    "SUNO_STATUS_PATH",
    "SUNO_RESULT_PATH",
    "SUNO_JOB_ID_FIELD",
    "SUNO_AUTH_HEADER",
    "SUNO_AUTH_SCHEME",
    "ALLOWED_ORIGINS"
  ],
  "routes": [
    "GET /health",
    "GET /debug (protected)",
    "POST /api/suno/create",
    "GET /api/suno/status/:id",
    "GET /api/suno/result/:id",
    "GET /api/suno/history",
    "GET /api/suno/adapter/status"
  ]
}
