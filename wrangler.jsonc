{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webradio-666soundsdesign-worker",
  "main": "worker.js",
  "compatibility_date": "2026-06-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "PLAYER_ALERT_BACKEND_URL": "https://666soundsdesign-alert-service.onrender.com",
    "PLAYER_ALERT_STORAGE_MODE": "RENDER_BACKEND_PRIMARY_OPTIONAL_KV_CACHE_LAST_V102",
    "GITHUB_CONFIG_PATH": "config/radio-runtime.json",
    "GITHUB_BACKUP_DIR": "config/backups",
    "ENABLE_PUBLIC_DEBUG": "false",
    "RELEASE_VERSION": "FULLVERSION_MESSAGE_BACKEND_REPAIR_v1.0.3"
  }
}
