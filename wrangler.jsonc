{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webradio-666soundsdesign-worker",
  "main": "worker-entry.js",
  "compatibility_date": "2026-06-25",
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DISCORD_NOWPLAYING_GATE",
        "class_name": "DiscordNowPlayingGate"
      }
    ]
  },
  "exports": {
    "DiscordNowPlayingGate": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "services": [
    {
      "binding": "PW_ADMIN_WORKER",
      "service": "666-system-pw-worker"
    },
    {
      "binding": "AUTH_ADMIN_WORKER",
      "service": "666-system-auth-worker"
    }
  ],
  "vars": {
    "PLAYER_ALERT_BACKEND_URL": "https://666soundsdesign-alert-service.onrender.com",
    "PLAYER_ALERT_STORAGE_MODE": "RENDER_BACKEND_PRIMARY_OPTIONAL_KV_CACHE_LAST_V120",
    "GITHUB_CONFIG_PATH": "config/radio-runtime.json",
    "GITHUB_BACKUP_DIR": "config/backups",
    "ENABLE_PUBLIC_DEBUG": "false",
    "RELEASE_VERSION": "FULLVERSION_RADIO_ONLY_CLEANUP_v1.2.22",
    "STREAM_ATTEMPT_TIMEOUT_MS": "2500",
    "STREAM_FAILOVER_BUDGET_MS": "12000",
    "ADMIN_SERVICE_ORIGIN": "https://webradio.666soundsdesign-broadcaster.com",
    "PUBLIC_PLAYER_ORIGIN": "https://webradio.666soundsdesign-broadcaster.com",
    "PW_LOGIN_URL": "https://666-system-pw.666soundsdesign-broadcaster.com/login",
    "ADMIN_AUTH_VERIFY_URL": "https://666-system-auth.666soundsdesign-broadcaster.com/verify",
    "AUTH_AUDIENCE": "666SOUNDsDESIGn-WebRadio-Admin"
  }
}
