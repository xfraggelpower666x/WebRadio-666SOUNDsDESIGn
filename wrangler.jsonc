{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webradio-666soundsdesign-worker",
  "main": "worker.js",
  "compatibility_date": "2026-06-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "PLAYER_ALERT_BACKEND_URL": "https://auto-setup-render-for-backend-mp3-ess8.onrender.com",
    "PLAYER_ALERT_STORAGE_MODE": "RENDER_BACKEND_PRIMARY_KV_FALLBACK_CACHE_LAST_V101",
    "GITHUB_CONFIG_PATH": "config/radio-runtime.json",
    "GITHUB_BACKUP_DIR": "config/backups",
    "ENABLE_PUBLIC_DEBUG": "false",
    "RELEASE_VERSION": "FULLVERSION_BRANCH_RECOVERY_v1.0.2"
  }
}
