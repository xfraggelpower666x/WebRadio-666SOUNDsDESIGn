{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webradio-666soundsdesign-worker",
  "main": "worker.js",
  "compatibility_date": "2026-06-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "PLAYER_ALERT_BACKEND_URL": "https://666soundsdesign-alert-service.onrender.com",
    "PLAYER_ALERT_STORAGE_MODE": "RENDER_BACKEND_PRIMARY_OPTIONAL_KV_CACHE_LAST_V102",
    "GITHUB_CONFIG_PATH": "config/radio-runtime.json",
    "GITHUB_BACKUP_DIR": "config/backups",
    "ENABLE_PUBLIC_DEBUG": "false",
    "RELEASE_VERSION": "FULLVERSION_AUTH_HARDLOCK_REPAIR_v1.1.0",
    "ADMIN_AUTH_LOGIN_URL": "https://666-system-pw.666soundsdesign-broadcaster.com/login",
    "ADMIN_AUTH_VERIFY_URL": "https://666-system-auth.666soundsdesign-broadcaster.com/verify",
    "ADMIN_SERVICE_ORIGIN": "https://webradio.666soundsdesign-broadcaster.com",
    "AUTH_AUDIENCE": "666SOUNDsDESIGn-WebRadio-Admin",
    "AUTH_MODE": "external_auth_worker"
  }
}
