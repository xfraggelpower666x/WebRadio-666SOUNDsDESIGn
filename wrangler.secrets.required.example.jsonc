/*
FILE: wrangler.secrets.required.example.jsonc
CREATED: 2026-05-15
PURPOSE: Optional helper only. Do not use as active config until SUNO secrets exist in Cloudflare.

WHY NOT ACTIVE BY DEFAULT:
Cloudflare validates secrets.required during deploy. If SUNO_API_KEY or SUNO_API_BASE are missing,
auto-deploy can fail. This file is therefore only a reference.

To activate later, copy this block into wrangler.jsonc after both secrets are already set in Cloudflare.
*/
{
  "keep_vars": true,
  "secrets": {
    "required": ["SUNO_API_KEY", "SUNO_API_BASE"]
  }
}
// v168: Optional second Discord webhook secret name: DISCORD_WEBHOOK_URL2
