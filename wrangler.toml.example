name = "666soundsdesign-songlab"
main = "worker/songlab-api-worker.js"
compatibility_date = "2026-03-18"

[[kv_namespaces]]
binding = "SONGLAB_DRAFTS"
id = "DEINE_KV_ID"

[vars]
OPENAI_MODEL = "gpt-5"
OPENAI_AUDIO_MODEL = "gpt-4o-mini-transcribe"


# set via: wrangler secret put SONGLAB_SESSION_SECRET
